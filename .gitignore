# .gitignore for RAG-LAW

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Streamlit secrets — NEVER commit real secrets ────────────────────────────
.streamlit/secrets.toml

# ── Local FAISS vectorstore ───────────────────────────────────────────────────
# The pre-built Vectorstore/ IS committed (used for cold-start on Streamlit Cloud).
# Exclude only the lowercase variant to avoid confusion.
vectorstore/

# ── Temp / uploaded files ─────────────────────────────────────────────────────
/tmp/
*.tmp

# ── Environment variable files ────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.DS_Store
Thumbs.db
